name = "yyyt0807/moonsparql"

version = "0.2.0"

repository = "https://github.com/yyyt0807/MoonSparql"

license = "Apache-2.0"

readme = "README.md"

description = "Bounded in-process SPARQL query evaluation over RDF graphs in MoonBit"

keywords = [ "sparql", "rdf", "query", "knowledge-graph" ]

preferred_target = "wasm-gc"

import {
  "thy1016/moonttl@0.3.0",
  "moonbitlang/async@0.22.5",
  "moonbitlang/quickcheck@0.15.0",
}
